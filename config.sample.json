// Article2Pod configuration.
// Copy this file to config.json and keep only the values you want to change: every key is optional.
// Paths default to ComfyUI Desktop's standard locations (its data folder is read from
// %APPDATA%\ComfyUI\config.json), so a standard Desktop install needs almost nothing here.
// "//" comments are allowed. Paths on Windows need doubled backslashes (\\).
{
  // ───────────────────────── Voice ─────────────────────────
  // Default voice sample (an mp3 in voice_folder). Use "shuffle" for a random one.
  // Default: the first mp3 in voice_folder. The gear icon in the web UI rewrites (or adds) this line.
  "voice_file": "your-voice-sample.mp3",
  // Folder holding your voice sample mp3s. Default: Article2Pod\voices
  "voice_folder": "C:\\ComfyUI\\Article2Pod\\voices",

  // ───────────────────────── Web interface ─────────────────────────
  // Port for the web UI. Default: 8080
  "web_port": 8080,
  // Queue save file, relative to the Article2Pod folder. Default: queue.json
  "queue_file": "queue.json",
  // Console logging: "verbose", "on_error" or "off". Default: off
  "log_level": "on_error",

  // ───────────────────────── ComfyUI launch ─────────────────────────
  // In the defaults below, <data> is ComfyUI Desktop's data folder (for example C:\ComfyUI) and
  // <install> is the Desktop app folder under %LOCALAPPDATA%.
  // Address of the ComfyUI server Article2Pod starts and talks to. Default: http://127.0.0.1:8000
  "comfy_url": "http://127.0.0.1:8000",
  // Address ComfyUI binds to. Default 0.0.0.0 (reachable on your LAN). Use 127.0.0.1 for this PC only.
  // "comfy_listen_host": "0.0.0.0",
  // Location of ComfyUI Desktop's app files, relative to %LOCALAPPDATA%. Default: detected, either
  // Comfy-Desktop\ComfyUI-Installs\ComfyUI\ComfyUI (current Desktop) or
  // Programs\@comfyorgcomfyui-electron\resources\ComfyUI (older Desktop). Set it only for a non-standard install.
  "comfy_electron_relative": "Comfy-Desktop\\ComfyUI-Installs\\ComfyUI\\ComfyUI",
  // ComfyUI base folder (its models, custom_nodes and user data). Default: the <install> folder on
  // current Desktop builds, the <data> folder on older ones.
  "comfy_base": "C:\\Users\\yourname\\AppData\\Local\\Comfy-Desktop\\ComfyUI-Installs\\ComfyUI\\ComfyUI",
  // Python inside ComfyUI's virtual environment. Default: <data>\.venv\Scripts\python.exe
  "comfy_venv_python": "C:\\ComfyUI\\.venv\\Scripts\\python.exe",
  // Seconds to wait for ComfyUI to come up. Raise for slow machines or big models. Default: 120
  "comfy_startup_timeout": 120,
  // Extra command-line flags passed to ComfyUI, e.g. ["--use-sage-attention"]. Default: none
  "comfy_extra_args": [],
  // Model folders to register with ComfyUI (Comfy Desktop keeps models outside the install). One path
  // or a list; folders that don't exist are skipped.
  // Default: <data>\models and %LOCALAPPDATA%\Comfy-Desktop\ComfyUI-Shared\models
  "comfy_shared_models_path": [
    "C:\\ComfyUI\\models",
    "C:\\Users\\yourname\\AppData\\Local\\Comfy-Desktop\\ComfyUI-Shared\\models"
  ],
  // Another custom_nodes folder to also load nodes from (skipped if it doesn't exist).
  // Default: <data>\custom_nodes
  "comfy_extra_custom_nodes_path": "C:\\ComfyUI\\custom_nodes",

  // ───────────────────────── Folders and files ─────────────────────────
  // ComfyUI input folder. The article text and voice sample are placed here. Default: <data>\input
  "input_folder": "C:\\ComfyUI\\input",
  // ComfyUI output root. Default: <data>\output
  "output_folder": "C:\\ComfyUI\\output",
  // Where ComfyUI drops generated audio before it gets tagged.
  // Default: output_folder plus the folder part of audio_output_prefix (<data>\output\audio)
  "audio_folder": "C:\\ComfyUI\\output\\audio",
  // Track number log, relative to the Article2Pod folder. Default: log\track-log.json
  "track_log": "log\\track-log.json",

  // ───────────────────────── Audio generation ─────────────────────────
  // One audio workflow (ComfyUI API format) per TTS engine, relative to the Article2Pod folder. An engine
  // is offered only if its file exists: copy workflow\workflow-api.vibevoice.sample.json and/or
  // workflow\workflow-api.breeze.sample.json to these names. With only one of them, every job uses it.
  // Defaults: workflow\workflow-api.vibevoice.json and workflow\workflow-api.breeze.json
  "workflow_file_vibevoice": "workflow\\workflow-api.vibevoice.json",
  "workflow_file_breeze": "workflow\\workflow-api.breeze.json",
  // Engine used when both workflows exist and neither the queue card, the site (domain_overrides) nor
  // the voice ("voices" below) picks one: "vibevoice" or "breeze". The settings gear in the app saves
  // this. Which engine a job uses, first match wins: the card > the site > the voice > tts_engine.
  // Default: vibevoice
  "tts_engine": "vibevoice",
  // Run the queue grouped by engine: after a job, the next article for the same engine goes first,
  // so the models are swapped less often. Off keeps your queue order. When the engine does change
  // between jobs, ComfyUI's memory is freed first (only if ComfyUI has no other jobs). Default: false
  "group_by_engine": false,
  // Settings per voice sample, keyed by file name in voice_folder (case doesn't matter, ".mp3"
  // optional). Breeze's own per-voice settings are in "breeze" -> "voices".
  //   engine   "vibevoice" or "breeze": the engine this voice uses unless the card or site picks one
  "voices": {
    // "YourVoice.mp3": { "engine": "vibevoice" }
  },
  // VibeVoice only. Filename prefix of your workflow's SaveAudioMP3 node. Default: audio/podcast
  "audio_output_prefix": "audio/podcast",
  // Long articles are split into chunks of about this many words, ending at a paragraph break where possible. Default: 1400
  "chunk_word_count": 1400,
  // Normalize loudness with ffmpeg after generation. Default: false
  "audio_normalize_enabled": false,
  // Save a log of each generation run. Default: true
  "generation_logging_enabled": false,

  // ───────────────────────── Breeze TTS 2 (only used for Breeze jobs) ─────────────────────────
  // Every key is optional except the genres: leave them out and every article gets the plain global
  // direction below. Before the voice reads an article, the text model from ai_cleanup picks one of
  // the genres listed under "genres" and which sentences are quotes. Each genre has a voice direction
  // (how to read) and a guidance value (how strongly to apply it: 1.0 ignores the direction, low values
  // keep more of the voice sample's own personality, high values follow the direction more closely but
  // can flatten the voice). Most specific wins: domain_overrides > a voice's genre settings > a voice's
  // own settings > the genre > the global values here.
  // The voice sample's transcript is created on first use (voices\<name>.txt; edit it if Whisper misheard;
  // it is only remade if you replace the mp3 with a newer file)
  // using ai_quality_check.asr_model_dir. Samples over 60 seconds are trimmed (voices\<name>.breeze.wav).
  // When ai_quality_check.mode is "retry", each piece is checked with Whisper and regenerated with a new
  // seed if it scores below min_match (short pieces are allowed two misheard words).
  "breeze": {
    // Guidance for the narration when the genre doesn't set narrator_guidance. Default: 1.5
    "guidance": 1.5,
    // Guidance for quotes when the genre doesn't set quote_guidance. Default: 2.5
    "quote_guidance": 2.5,
    // Variation in delivery. 0.9 is Breeze's default; higher is more varied but can slur words.
    "temperature": 0.9,
    // Seed for the first take of every piece (same seed + same text = same audio). Retries use random seeds.
    "seed": 42,
    // How the genre is picked: "llm" (the text model reads the article) or "off" (always default_genre,
    // unless a site in domain_overrides sets "genre").
    "genre_mode": "llm",
    // How quotes are found: "llm" (text model, checked against the quotation marks), "marks" (quotation
    // marks only) or "off" (only indented block quotes).
    "quote_mode": "llm",
    // The article is generated in pieces of up to this many words. Lowered automatically for long voice
    // samples, because Breeze fits the sample and the text into one 2048-token window.
    "max_segment_words": 170,
    // Longest voice sample used, in seconds (60 is Breeze's limit).
    "max_reference_seconds": 60,
    // Silence between pieces, in seconds: between two pieces of narration (or two of quotes), where
    // narration and quotes switch, after the title, and at the end of the episode.
    "sentence_gap": 0.45,
    "switch_gap": 0.65,
    "title_gap": 0.9,
    "end_pause": 3.0,
    // Text-model workflow used for genre and quotes (the same one ai_cleanup uses).
    "workflow_file": "workflow/cleanup-workflow-api.json",
    // Seconds to wait for the text model, including time queued behind other ComfyUI jobs. If it times
    // out, default_genre and the quotation-mark check are used.
    "timeout_seconds": 1800,
    // Direction used when no genre applies (no genres listed, or none picked). Defaults shown.
    "narrator": "Clear, natural, conversational delivery.",
    "quote": "Clear, natural, conversational delivery.",
    // Genre used when genre_mode is "off" or the text model fails. Must be one of the genres below.
    // Default: none (the global values above).
    "default_genre": "news",
    // The genres the text model chooses from. Add, rename or remove genres freely; the names and
    // descriptions are what the model sees. Keys (all optional):
    //   description        what belongs in this genre, shown to the text model
    //   narrator           voice direction for the writer's own words
    //   narrator_guidance  guidance for the narration (falls back to "guidance" above)
    //   quote              voice direction for quotes
    //   quote_guidance     guidance for quotes (falls back to "quote_guidance" above)
    //   quote_cue          spoken before each quote, e.g. "Quote:" ("" for none)
    //   quote_end_pause    seconds of silence after a quote
    //   temperature        variation in delivery for this genre
    // opinion and news were tuned by ear; the others are untested starting points.
    "genres": {
      "opinion": {
        "description": "columns, op-eds, blogs and commentary in the writer's own voice, with strong views, sarcasm or humour (for example political columnists)",
        "narrator": "Lively, animated, cheeky British comic delivery with a brisk pace, sarcastic emphasis and lots of expression.",
        "narrator_guidance": 1.25,
        "quote": "Confident, energetic news anchor delivery: loud, clear, brisk and authoritative.",
        "quote_guidance": 2.5,
        "quote_cue": "",
        "quote_end_pause": 0.65
      },
      "news": {
        "description": "straight reporting of politics, business, world and other general news, written in a neutral third-person voice",
        "narrator": "Confident, energetic news anchor delivery: loud, clear, brisk and authoritative.",
        "narrator_guidance": 2.5,
        "quote": "Confident, energetic news anchor delivery: loud, clear, brisk and authoritative.",
        "quote_guidance": 2.5,
        "quote_cue": "Quote:",
        "quote_end_pause": 1.0
      },
      "entertainment": {
        "description": "film, TV, music, celebrities, culture and reviews of them, even when written as a news report",
        "narrator": "Warm, upbeat and lightly playful conversational delivery with personality and a brisk pace.",
        "quote": "Confident, energetic news anchor delivery: loud, clear, brisk and authoritative.",
        "quote_cue": "",
        "quote_end_pause": 0.65
      },
      "tech_gaming": {
        "description": "technology, gadgets, software, video games and hardware news or reviews, even when written as a news report",
        "narrator": "Enthusiastic, knowledgeable and conversational delivery, like a friendly expert host, with a brisk pace.",
        "quote": "Confident, energetic news anchor delivery: loud, clear, brisk and authoritative.",
        "quote_cue": "",
        "quote_end_pause": 0.65
      },
      "feature": {
        "description": "long-form storytelling, profiles and in-depth magazine pieces",
        "narrator": "Engaging, thoughtful storytelling delivery with natural variety in pace and emphasis.",
        "quote": "Confident, energetic news anchor delivery: loud, clear, brisk and authoritative.",
        "quote_cue": "",
        "quote_end_pause": 0.65
      },
      "humor": {
        "description": "satire and comedy writing",
        "narrator": "Playful, cheeky comic delivery with crisp timing and lots of expression.",
        "quote": "Confident, energetic news anchor delivery: loud, clear, brisk and authoritative.",
        "quote_cue": "",
        "quote_end_pause": 0.65
      },
      "interview": {
        "description": "a question-and-answer interview or transcript",
        "narrator": "Curious, friendly and conversational delivery with a brisk pace.",
        "quote": "Confident, energetic news anchor delivery: loud, clear, brisk and authoritative.",
        "quote_cue": "",
        "quote_end_pause": 0.65
      }
    },
    // Per-voice settings, for voices the defaults don't suit. Keyed by the voice's file name in voice_folder
    // (case doesn't matter, ".mp3" optional). Used whenever that voice reads an article, from shuffle, the
    // default voice, a per-site voice or a per-article pick. Only list what you want to change.
    //   guidance         narration guidance for this voice in every genre (beats the genre presets)
    //   quote_guidance, temperature, narrator, quote, quote_cue, quote_end_pause
    //                    same meaning as in "genres", applied to every genre for this voice
    //   genres           this voice's settings for one genre, same keys as "genres" above; beats the
    //                    voice's own settings
    "voices": {
      // "YourVoice.mp3": {
      //   "temperature": 1.0,
      //   "genres": {
      //     "news": { "narrator_guidance": 2.0 },
      //     "opinion": { "narrator": "Exasperated, ranting delivery with sarcastic emphasis and a brisk pace." }
      //   }
      // },
      // "AnotherVoice.mp3": { "guidance": 1.75 }
    }
  },

  // ───────────────────────── AI cleanup & quality check (optional, slower) ─────────────────────────
  // Both features are off by default. They add time to every article, so turn them off
  // ("mode": "off") whenever speed matters more.
  //
  // AI cleanup runs after you click generate. A text model in ComfyUI looks for leftover page
  // junk (captions, promos, repeated bylines) and checks the title / author / site. It only picks
  // lines to delete; it never rewrites the article. Metadata you edited yourself is never changed.
  //   mode          off | log_only (decide and log, change nothing) | apply
  //   workflow_file  API-format workflow that runs the text model. To change the model, edit it there
  //                  (CLIPLoader node). Keep the {{prompt}} and {{system_prompt}} placeholders and a PreviewAny node
  //   max_remove_fraction  a result that would delete more of the article than this is refused
  //   fix_metadata  also correct title / author / site
  "ai_cleanup": {
    "mode": "off",
    "workflow_file": "workflow/cleanup-workflow-api.json",
    "max_remove_fraction": 0.30,
    "fix_metadata": true
  },
  // Quality check: each generated chunk is transcribed with Whisper and compared with its text.
  //   mode          off | log_only (score and log only) | retry (regenerate chunks scoring below min_match)
  //   asr_model_dir folder of a Whisper checkpoint (for example openai/whisper-large-v3-turbo)
  //   min_match     1 minus word error rate needed to accept a chunk. max_attempts per chunk, best kept
  "ai_quality_check": {
    "mode": "off",
    "asr_model_dir": "C:\\path\\to\\whisper-large-v3-turbo",
    "device": "cuda",
    "min_match": 0.92,
    "max_attempts": 5
  },
  // Art prompt: when album art is generated (comfyui_generate in art_sources), the text model reads
  // the title and the start of the article and writes a detailed image prompt for it. It fills the
  // {{PROMPT}} token in the art workflow's prompt node. On failure the plain title template is used.
  //   mode              off | on
  //   workflow_file     text-model workflow, same format as ai_cleanup's
  //   max_article_words how much of the article the model reads
  "ai_art_prompt": {
    "mode": "off",
    "workflow_file": "workflow/cleanup-workflow-api.json",
    "max_article_words": 700
  },
  // Write stats about both features to log/ai-*.csv so you can judge their effect on speed and quality.
  "ai_stats_logging": true,

  // ───────────────────────── Album art ─────────────────────────
  // Sources tried in order until one works:
  //   website          the article's own image
  //   image_search     web image search
  //   comfyui_generate generate one with ComfyUI
  //   favicon          the site's icon
  //   default          default_art.jpg
  //   none             stop here and use no art
  "art_sources": ["website", "image_search", "comfyui_generate", "favicon", "default"],
  // Art workflow (ComfyUI API format), relative to the Article2Pod folder. Default: workflow\art-workflow-api.json
  // if that file exists, otherwise no ComfyUI art. A {{PROMPT}} token in the
  // prompt node is replaced with the ai_art_prompt result (or the title template when that is off).
  // The sample workflow uses MOSS-Image SFT.
  "art_workflow_file": "workflow\\art-workflow-api.json",
  // Title of the workflow node that holds the text prompt. Leave empty to auto-detect
  // when the workflow has just one prompt node (CLIPTextEncode).
  "art_prompt_node_title": "",
  // Class of the workflow node that saves the image. Default: SaveImage
  "art_save_node_class": "SaveImage",
  // Seconds to wait for art generation. Default: 300
  "art_generation_timeout": 300,
  // Optional. Text in your workflow's prompt node to swap for the article title,
  // instead of replacing the whole prompt with the built-in template.
  // "art_prompt_placeholder": "{title}",

  // ───────────────────────── Article scraping ─────────────────────────
  // User agent sent when fetching pages. Default: Mozilla/5.0
  "user_agent": "Mozilla/5.0",
  // Sites that block scraping or are paywalled. These go straight to paste mode.
  "clipboard_domains": [
    "example-paywalled-site.com"
  ],
  // Anything after one of these phrases is cut from the article (newsletter pitches, ads, etc.)
  "ad_strip_markers": [
    "Example: Sign up for our newsletter"
  ],
  // Whole lines to delete (share buttons, photo credits, etc). Each entry is an exact
  // line (case-insensitive) or "re:<regex>". Regex entries only apply to lines up to 120 characters.
  "strip_lines": [
    "Link copied to clipboard",
    "re:^(image|photo|credit)s?\\s*:"
  ],
  // Find and replace in the text before speech, to fix mispronunciations.
  "phonetic_replacements": {
    "2026": "twenty twenty six"
  },

  // ───────────────────────── Per-site overrides ─────────────────────────
  // Settings for one site. Matches the domain and its subdomains.
  //   voice_file  voice to use for this site
  //   engine      "vibevoice" or "breeze" for this site's articles (the card can still change it)
  //   art_path    image to always use as the art (relative to the Article2Pod folder)
  //   Breeze only (all optional):
  //   genre                  always use this genre's preset for the site (skips the text model's guess)
  //   breeze_narrator        voice direction for the narration
  //   breeze_guidance        guidance for the narration
  //   breeze_quote           voice direction for quotes
  //   breeze_quote_guidance  guidance for quotes
  //   breeze_quote_cue       spoken before quotes ("" for none)
  //   breeze_temperature     variation in delivery
  "domain_overrides": {
    "sample.com": {
      "voice_file": "your-voice-sample.mp3",
      "art_path": "art\\sample-default.jpg"
    },
    "columnist-site.com": {
      "genre": "opinion",
      "breeze_guidance": 1.25
    }
  }
}
